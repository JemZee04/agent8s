# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Get your own id from @userinfobot. This is a hard whitelist checked before anything else.
ALLOWED_CHAT_IDS=

# Where SQLite state and git worktrees live. Defaults are fine for local use.
AGENT8S_DATA_DIR=./data
AGENT8S_WORKTREE_DIR=./worktrees

# Where /new creates brand-new project directories.
AGENT8S_PROJECTS_DIR=~/Documents

# Default agent used for new tasks: claude | codex
AGENT8S_DEFAULT_AGENT=claude

# Tools the claude CLI is pre-authorized to use without prompting (headless has no one to ask).
# Skill is included so claude can pick up your configured skills (~/.claude/skills, plugins)
# on its own when a task matches one — same auto-trigger behavior as an interactive session.
AGENT8S_CLAUDE_ALLOWED_TOOLS=Bash,Edit,Write,Read,Grep,Glob,Skill
AGENT8S_CLAUDE_PERMISSION_MODE=acceptEdits

# Codex sandbox policy for headless runs: read-only | workspace-write | danger-full-access
AGENT8S_CODEX_SANDBOX=workspace-write

# Jira/Confluence Server or Data Center, Personal Access Token auth.
# Create a PAT: avatar (top right) -> Profile -> Personal Access Tokens -> Create token.
# Leave blank to skip Atlassian entirely — /context and /task will say so and no-op.
JIRA_URL=
JIRA_PERSONAL_TOKEN=
JIRA_SSL_VERIFY=true

CONFLUENCE_URL=
CONFLUENCE_PERSONAL_TOKEN=
CONFLUENCE_SSL_VERIFY=true

# Yandex Calendar via CalDAV. Get the URL from Calendar -> Settings -> Export
# in the web UI, and use an app password (id.yandex.ru -> Security -> App
# passwords), not your normal account password. Leave blank to skip — no
# /today, no reminders.
YANDEX_CALDAV_URL=
YANDEX_CALDAV_LOGIN=
YANDEX_CALDAV_PASSWORD=

# How far ahead of an event to send a reminder, and how often to check.
AGENT8S_REMINDER_LEAD_MINUTES=15
AGENT8S_REMINDER_POLL_SECONDS=300

# Yandex Cloud billing balance alerts. The Billing API needs a real IAM
# token, not a static API key, so this needs a service account (not a
# personal OAuth token — Yandex's own docs say those aren't for automation):
#   1. Console -> your billing account's cloud -> Service accounts -> Create,
#      grant it the billing.accounts.viewer role on the billing account.
#   2. That service account -> Create new key -> Create authorized key ->
#      download the JSON file, drop it in ./data/ (gitignored).
#   3. Billing account ID is in the console URL / the Billing section.
# Leave blank to skip entirely — no /balance, no low-balance alerts.
YC_SERVICE_ACCOUNT_KEY_FILE=./data/yc-authorized-key.json
YC_BILLING_ACCOUNT_ID=
# In the billing account's own currency (RUB/USD/KZT) — alert once balance
# drops below this.
YC_BALANCE_ALERT_THRESHOLD=
YC_BALANCE_POLL_SECONDS=1800
# Don't re-alert more often than this while balance stays low.
YC_BALANCE_ALERT_COOLDOWN_HOURS=12

# Phone client (desktop app -> "Phone" dialog): HTTPS address of your relay, see README.
# AGENT8S_RELAY_URL=https://example.com/agent8s
AGENT8S_RELAY_URL=
