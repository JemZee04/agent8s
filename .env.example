# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Get your own id from @userinfobot. This is a hard whitelist checked before anything else.
ALLOWED_CHAT_IDS=

# Where SQLite state and git worktrees live. Defaults are fine for local use.
AGENT8S_DATA_DIR=./data
AGENT8S_WORKTREE_DIR=./worktrees

# Where /new creates brand-new project directories.
AGENT8S_PROJECTS_DIR=~/Documents

# Default agent used for new tasks: claude | codex
AGENT8S_DEFAULT_AGENT=claude

# Tools the claude CLI is pre-authorized to use without prompting (headless has no one to ask).
AGENT8S_CLAUDE_ALLOWED_TOOLS=Bash,Edit,Write,Read,Grep,Glob
AGENT8S_CLAUDE_PERMISSION_MODE=acceptEdits

# Codex sandbox policy for headless runs: read-only | workspace-write | danger-full-access
AGENT8S_CODEX_SANDBOX=workspace-write

# Jira/Confluence Server or Data Center, Personal Access Token auth.
# Create a PAT: avatar (top right) -> Profile -> Personal Access Tokens -> Create token.
# Leave blank to skip Atlassian entirely — /context and /task will say so and no-op.
JIRA_URL=
JIRA_PERSONAL_TOKEN=
JIRA_SSL_VERIFY=true

CONFLUENCE_URL=
CONFLUENCE_PERSONAL_TOKEN=
CONFLUENCE_SSL_VERIFY=true
